# ============================================
# BDE - AI-Powered Email Automation System
# Environment Variables Configuration
# ============================================
# 
# INSTRUCTIONS:
# 1. Copy this file and rename it to .env
# 2. Fill in your actual credentials below
# 3. NEVER commit .env to GitHub (it's in .gitignore)
#
# ============================================

# ============================================
# EMAIL CONFIGURATION
# ============================================
GMAIL_ADDRESS=your.email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# NOTE: To generate Gmail App Password:
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Enable 2-Factor Authentication first
# 3. Generate an app password for "Mail"
# 4. Use that 16-character password here

# ============================================
# OPENAI API CONFIGURATION
# ============================================
OPENAI_API_KEY=sk-proj-your-api-key-here

# Model Selection:
# - gpt-3.5-turbo: Faster, cheaper ($0.002/email)
# - gpt-4: Better quality, more expensive ($0.03/email)
OPENAI_MODEL=gpt-3.5-turbo

# NOTE: Get your API key at https://platform.openai.com/api-keys

# ============================================
# CAMPAIGN SETTINGS
# ============================================
# Maximum emails to send per run
MAX_EMAILS_PER_RUN=260

# Delay between emails (in seconds)
# Recommended: 120-180 to avoid spam filters
MIN_DELAY_SECONDS=120
MAX_DELAY_SECONDS=180

# Calculate fit score for analytics (true/false)
# Note: Fit score is for tracking only, all contacts will receive emails
CALCULATE_FIT_SCORE=true

# ============================================
# POSTGRESQL DATABASE CONFIGURATION
# ============================================
# PostgreSQL Connection Settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bde_email_automation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# Batch Processing
BATCH_SIZE=50

# NOTE: Your PostgreSQL connection string will be:
# postgresql://postgres:your_password@localhost:5432/bde_email_automation
# This is automatically built by Config.get_database_url()

# ============================================
# LOGGING
# ============================================
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
LOG_FILE=data/logs/email_sender.log

# ============================================
# OPTIONAL: WEB SCRAPING SETTINGS
# ============================================
# USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
# SCRAPING_TIMEOUT=10
# MAX_RETRIES=3

# ============================================
# OPTIONAL: PROXY SETTINGS (if scraping blocked)
# ============================================
# PROXY_URL=http://your-proxy-server:port
# PROXY_USERNAME=username
# PROXY_PASSWORD=password
